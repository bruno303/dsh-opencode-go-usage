+    // The failed reload must not have refreshed the TTL window.
+    expect(cache.isFresh()).toBe(false)
+  })
+
+  it('marks a reading stale when a reload cannot be parsed', async () => {
+    const cache = makeCache()
+    cache.set(ok())
+    clock = 10_000
+
