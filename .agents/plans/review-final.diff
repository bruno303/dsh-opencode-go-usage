+    cache.set(ok())
+    clock = 900
+    cache.set(ok('2026-10-10T00:01:00.000Z'))
+
+    clock = 1500
+    expect(cache.ageMs()).toBe(600)
+    expect(cache.isFresh()).toBe(true)
+  })
+
+  it('shares one in-flight loader invocation between concurrent callers', async () => {
